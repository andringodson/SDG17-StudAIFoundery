# Copy to server/.env and fill in.

PORT=8787

# Same Postgres connection string as the web app's DATABASE_URL.
DATABASE_URL=

# From @BotFather on Telegram: message it, send /newbot, follow the prompts.
# You'll get a token like 123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# The web app's deployed URL (e.g. https://sdg17-studaifoundery.vercel.app).
# The bot POSTs here to complete Telegram account linking.
WEB_APP_URL=

# Must match INTERNAL_SHARED_SECRET in the web app's .env.local exactly.
INTERNAL_SHARED_SECRET=
