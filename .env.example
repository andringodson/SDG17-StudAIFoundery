# Copy to .env.local and fill in. Every value here has a fallback that keeps
# the app running (routes return a clear 503, OTP logs to console, etc.) so
# you can develop the frontend before any of these accounts exist.

# --- Database (Neon recommended — serverless Postgres; any Postgres 14+ works) --
# Neon: console.neon.tech -> your project -> Connection string (use the pooled
# "-pooler" host for serverless — it batches connections instead of opening one
# per request, which is what makes it fast under bursty traffic). Comes with
# ?sslmode=require already appended. Also installable straight from Vercel:
# Project -> Storage -> Marketplace Database Providers -> Neon.
# (Supabase's connection string works unchanged too, if you'd rather use that.)
DATABASE_URL=

# --- Sessions -----------------------------------------------------------------
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Email OTP (Resend) --------------------------------------------------------
# resend.com -> API Keys. Free tier: 3,000 emails/month.
# Without this, OTP codes are logged only in local development, never production.
# Production requires a verified domain in Resend and RESEND_FROM on that domain.
# onboarding@resend.dev is test-only: it can send only to the Resend account owner.
RESEND_API_KEY=
RESEND_FROM="SDG 17 Hub <onboarding@resend.dev>"

# --- Telegram bot -------------------------------------------------------------
# Message @BotFather on Telegram -> /newbot -> follow the prompts.
# TELEGRAM_BOT_TOKEN goes in server/.env (the bot process), NOT here.
# TELEGRAM_BOT_USERNAME (without the @) is needed here to build the deep link.
TELEGRAM_BOT_USERNAME=

# --- Internal server-to-server auth --------------------------------------------
# Shared secret between this web app and server/ (the bot + WebSocket process).
# Generate one the same way as JWT_SECRET. Must match server/.env exactly.
INTERNAL_SHARED_SECRET=

# URL of the deployed server/ process, used by /api/votes to push live updates.
WS_SERVER_INTERNAL_URL=

# --- Real-time client -----------------------------------------------------------
# Public WebSocket URL the browser connects to for the live poll.
# wss://<your-server-host>/live — without this, the poll falls back to
# polling /api/votes every 6 seconds, which still works.
NEXT_PUBLIC_WS_URL=

# --- Public app URL (also used to build OAuth redirect URIs and email links) ---
# e.g. https://sdg17-studaifoundery.vercel.app in production, http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=

# --- Social sign-in (Google) ----------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
# Without both values set, the Google button on /auth/login stays honestly disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Social sign-in (Facebook) ---------------------------------------------------
# Meta for Developers -> your app -> Facebook Login -> Settings.
# Valid OAuth Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/facebook/callback
# Without both values set, the Facebook button on /auth/login stays honestly disabled.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Assistant LLM fallback (Groq — free, open-weight models) --------------------
# console.groq.com -> API Keys. Free tier, no credit card. Hosts open-source
# models (Llama 3.x, Gemma 2, ...) on inference hardware built for low latency.
# Without this, the assistant still works fully on its rule-based intents and
# keyword knowledge base — this only adds an open-ended answer tier on top.
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile. Swap to llama-3.1-8b-instant
# for lower latency at some quality cost, or any other Groq-hosted model id.
GROQ_MODEL=

# --- SMS confirmations (Twilio) ---------------------------------------------------
# twilio.com -> Console -> Account SID + Auth Token, and a Twilio phone number.
# Requires a Twilio account (identity/payment-verified — cannot be scripted).
# Without all three set, the phone field on /support still works but sends no SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
